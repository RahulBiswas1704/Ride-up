{
  "expo": {
    "name": "Ride-Up",
    "slug": "rydyt-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rideup-icon.jpg",
    "scheme": "rideup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/rideup-icon.jpg",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "We need your microphone for rider-to-rider group intercom",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/rideup-icon.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/rideup-icon.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.rideup"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/rideup-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/rideup-icon.jpg",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ride-Up to use your location for group ride tracking."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f604fca-f0cf-424b-878d-4b830ca2f56f"
      }
    },
    "owner": "rahul.biswas1704"
  }
}
